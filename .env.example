# Copy to .env and fill in. .env is git-ignored: no token or password belongs in the repository
# (NFR-06).

# The bot token from the Discord Developer Portal. Use the "Stanley Dev" application's token
# for development, never production's. Needed only to run the bot inside Docker; a host-side
# `dotnet run` reads it from `dotnet user-secrets` instead and leaves this empty.
DISCORD_TOKEN=

# Your private test servers, comma-separated (111,222). While any is listed, commands register
# to those servers alone and appear instantly. Leave it empty to fall back to the list in
# src/Stanley.Bot/appsettings.Development.json, and empty in production to register globally.
DISCORD_TEST_GUILD_IDS=

# The server holding the Wiki Editor role, and the role itself, matched by ID (FR-17 is still
# deferred, so these can stay empty until it is decided).
DISCORD_HOME_GUILD_ID=
DISCORD_WIKI_EDITOR_ROLE_ID=

# Database. The password is only used by these two containers, and is required for either run
# path. It is applied when the postgres-data volume is first created; changing it afterwards
# needs `docker compose down -v`, which deletes the data.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Development or Production.
DOTNET_ENVIRONMENT=
